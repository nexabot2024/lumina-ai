PORT=5000
NODE_ENV=development

# AI APIs
ANTHROPIC_API_KEY=your_anthropic_key_here
AI33PRO_API_KEY=your_ai33pro_key_here
AI33PRO_BASE_URL=your_ai33pro_base_url_here
AI33PRO_WEBHOOK_URL=your_ai33pro_webhook_url_here
AI84PRO_API_KEY=your_ai84pro_key_here
AI84PRO_BASE_URL=your_ai84pro_base_url_here

# Búsqueda
BRAVE_API_KEY=your_brave_search_api_key_here

# Stock APIs
PIXABAY_API_KEY=your_pixabay_key_here
PEXELS_API_KEY=your_pexels_key_here

# File uploads
MAX_FILE_SIZE=50000000
UPLOAD_DIR=./uploads

# FFmpeg / ffprobe — déjalas sin poner en Mac/Linux: el sistema usa el binario del
# PATH (instalado con `brew install ffmpeg`) automáticamente. Solo hacen falta en
# Windows si no tienes FFmpeg en una carpeta estándar.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# yt-dlp — igual que FFmpeg, se resuelve solo desde el PATH si no se define.
# YTDLP_PATH=yt-dlp

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Canva Connect API (opcional)
CANVA_CLIENT_ID=your_canva_client_id_here
CANVA_CLIENT_SECRET=your_canva_client_secret_here
CANVA_REDIRECT_URI=http://localhost:5000/api/canva/callback
